NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/lms
JWT_ACCESS_SECRET=dev-access-secret-min-32-characters-long!!
JWT_REFRESH_SECRET=dev-refresh-secret-min-32-characters-long!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
CLIENT_URL=http://localhost:5173
ADMIN_EMAIL=admin@lms.edu
ADMIN_PASSWORD=Admin@123456
LIBRARIAN_EMAIL=librarian@lms.edu
LIBRARIAN_PASSWORD=Librarian@123456
STUDENT_EMAIL=student@lms.edu
STUDENT_PASSWORD=Student@123456
STUDENT_PHONE=+923001234567

# WhatsApp notifications (optional — logs to console when not configured)
# Option A: Twilio WhatsApp
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Option B: Meta WhatsApp Cloud API (native reply buttons for confirmations)
# WHATSAPP_CLOUD_TOKEN=
# WHATSAPP_CLOUD_PHONE_NUMBER_ID=
# WHATSAPP_CONFIRMATION_PROVIDER=auto

# Country code for local numbers without + prefix (default: 92)
WHATSAPP_DEFAULT_COUNTRY_CODE=92
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_meta_verify_token
WEBHOOK_BASE_URL=http://localhost:5000

# WasenderApi (recommended for local dev + ngrok) — https://wasenderapi.com
WASENDER_API_KEY=
WASENDER_WEBHOOK_SECRET=
# WASENDER_API_BASE_URL=https://www.wasenderapi.com
